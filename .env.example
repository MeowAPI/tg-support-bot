# 必填：从 @BotFather 获取
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 超级管理员的 Telegram 用户 ID，多个用逗号分隔（面板里无法移除）
# 不知道自己的 ID：先留空启动机器人，私聊它发送 /id
ADMIN_IDS=

# 以下均为可选
# DB_PATH=data/bot.db
# ACK_COOLDOWN=10m            # 同一用户多久内只自动回复一次
# LINK_RETENTION_DAYS=90      # 回复映射保留天数，过期后无法再回复那条旧消息
# LOG_LEVEL=debug
# TELEGRAM_API_BASE=https://api.telegram.org
# HTTPS_PROXY=http://127.0.0.1:7890
